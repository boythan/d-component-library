{
  "name": "d-react-components",
  "version": "1.0.0",
  "main": "dist/cjs/dcomponent.js",
  "module": "dist/es/dcomponent.js",
  "typings": "dist/types/dcomponent.d.ts",
  "style": "dist/es/index.css",
  "source": "src/dcomponent.tsx",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/es/dcomponent.js",
      "require": "./dist/cjs/dcomponent.js",
      "types": "./dist/types/dcomponent.d.ts"
    },
    "./dist/*": "./dist/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boythan/d-component-library.git"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "query-string": "9.4.0",
    "react-dropzone": "^15.0.0",
    "react-highlight-words": "^0.21.0",
    "react-resizable": "^4.0.2",
    "yet-another-react-lightbox": "^3.32.0"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "rollup -c --bundleConfigAsCjs",
    "build-watch": "rollup -c -w --bundleConfigAsCjs",
    "start-demo": "vite",
    "i-all": "npm i && npm i",
    "dev": "npm-run-all --parallel build-watch start-demo",
    "start": "vite",
    "start:legacy": "vite",
    "buildReact": "vite build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "publishD": "rollup -c --bundleConfigAsCjs && npm run build-cp-variable && npm publish"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.0.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-highlight-words": "^0.20.1",
    "@types/react-resizable": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "@vitejs/plugin-react": "^6.0.2",
    "antd": "^6.4.4",
    "autoprefixer": "^10.5.0",
    "dayjs": "^1.11.21",
    "eslint": "10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.2.0",
    "lodash": "^4.18.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rollup": "4.62.0",
    "rollup-plugin-commonjs": "^10.1.0",
    "rollup-plugin-node-resolve": "^5.2.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.37.0",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "antd": ">=6.0.0",
    "dayjs": ">=1.0.0",
    "lodash": ">=4.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "description": "",
  "bugs": {
    "url": "https://github.com/boythan/d-component-library/issues"
  },
  "keywords": [
    "react-component"
  ],
  "author": "D.",
  "license": "UNLICENSED"
}
